# ─────────────────────────────────────────────────────────────────────────────
# All of these are OPTIONAL. The site builds, deploys and works with none of
# them set. Copy this file to .env.local for local development, and add the
# same keys in Vercel → Project → Settings → Environment Variables for production.
# ─────────────────────────────────────────────────────────────────────────────

# Public site URL — used for canonical tags, Open Graph, sitemap.xml and robots.txt.
# Set this before going live, or every canonical URL will point at the fallback domain.
NEXT_PUBLIC_SITE_URL=https://abuilderhut.com

# Where enquiries from the contact and free-trial forms are delivered.
# Server-side only (no NEXT_PUBLIC_ prefix) so the endpoint is never exposed in the browser.
# Any service that accepts a JSON POST works: Formspree, Web3Forms, a Google Apps
# Script web app, or your own CRM webhook.
#
# Leave it unset and /api/contact responds with a WhatsApp fallback instead — the
# browser opens a chat with the enquiry pre-filled, so nothing is ever lost.
FORM_ENDPOINT=

# Optional: Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX).
# Analytics is skipped entirely when this is empty.
NEXT_PUBLIC_GA_ID=
